# ==========================================
# Anon eCommerce Full-Stack Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Database Configuration
# Provide your Supabase project URL and service/anon keys below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection URL (from Supabase Database Settings)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Payment Gateway Configuration (Optional - Stripe / Test Secret Keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
